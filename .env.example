# Copy this file to .env and fill in real values.
# NEVER commit .env to the repository.

# ---------- LLM ----------
# DeepSeek API key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional explicit proxy for the LLM API; blank means direct connection.
# Example: http://127.0.0.1:7890 (system HTTP_PROXY/HTTPS_PROXY are ignored).
DEEPSEEK_PROXY=
DEEPSEEK_MODEL=deepseek-chat
# M1.5-a demo hardening: 有界超时（秒）+ 有界重试，替代 SDK 默认 600s。
# demo 现场体感默认 60/2，可按 A 档延迟实况覆盖。
DEEPSEEK_TIMEOUT_S=60
DEEPSEEK_MAX_RETRIES=2

# ---------- Embedding ----------
# 默认走本地模型目录（首次使用前先跑 scripts/download_models.sh 拉到这里）。
# 若想直接用 HuggingFace cache，改成 EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5。
EMBEDDING_MODEL=data/models/bge-large-zh-v1.5

# ---------- Storage ----------
# SQLite database URL (relative paths resolved from backend/)
DATABASE_URL=sqlite:///./data/app.db

# Chroma persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# ---------- RAG Chat ----------
# Default false keeps the backend bootable without rag extras or a local Chroma index.
# Demo profile（A2）: 跑可演示的 demo 路径需把 RAG_ENABLED=true、RAG_RERANKER_ENABLED=true，
# 并已用 scripts/index_papers.py 建好索引；ref-filter/overfetch 默认已对齐 A2（见下方）。
RAG_ENABLED=false
RAG_CHROMA_DIR=./var/chroma
RAG_COLLECTION=papers
CHAT_TOP_K=5
CHAT_MAX_CONTEXT_CHARS=4000
CHAT_TEMPERATURE=0.3

# ---------- RAG Reranker (M1.4-b) ----------
# 二阶段检索：embedding 召回 top_k_recall → reranker 重排取 top_n。
# 关闭时纯 embedding 路径，行为与 M1.3.x 完全一致。
# 模型 ~2.2 GB，启用前先跑 scripts/download_models.sh reranker。
RAG_RERANKER_ENABLED=false
RAG_RERANKER_TOP_K_RECALL=20
RAG_RERANKER_TOP_N=5
RAG_RERANKER_MODEL=data/models/bge-reranker-v2-m3

# ---------- RAG Reference Filter (M1.4-c experiment) ----------
# Drops likely bibliography/reference-list chunks after embedding recall and
# before reranking.
# M1.5-a: on/overfetch=10 是 M1.4-c 验证过的 demo 默认（A2 配置）——全矩阵唯一
# 让 q04 evidence-level 翻盘的组合（079::0004/0005 进 final context）。改这两个值
# 会直接影响 q04 是否拒答；非必要勿动。这是 demo 默认，不是最终最优检索策略。
RAG_REFERENCE_FILTER_ENABLED=true
RAG_REFERENCE_FILTER_MIN_KEEP=1
RAG_REFERENCE_FILTER_OVERFETCH=10

# ---------- RAG Numeric/Evidence Boost (M1.5-b) ----------
# Reranker post-processing：把 cross-encoder 低估的数值/统计数据段提回 top_n
# （解 q08 的 R²/RMSE/IA 段 026::0172）。只在 RAG+reranker 路径生效，不改
# RAG_ENABLED / RAG_RERANKER_ENABLED 的 opt-in 语义；非 RAG 或非 reranker 路径零变化。
# weight/band 是 DoD-2 验证过的默认：该配置下 mini-eval 仅 q08 的 top_n 变化，
# 其余九题与 boost-off 逐字一致。band = 只对「reranker 判定够相关」的候选 boost，
# 避免无关高密度段被硬抬（q01 回归修复）。
RAG_NUMERIC_BOOST_ENABLED=true
RAG_NUMERIC_BOOST_WEIGHT=0.445
RAG_NUMERIC_BOOST_BAND=0.30

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO

# Agent run records (relative paths resolve from backend/).
AGENT_TRACE_DB=var/agent/runs.sqlite3
# Evaluation APIs are off by default; access keys are server-side identities.
EVAL_ENABLED=false
EVAL_ACCESS_FILE=var/eval/access-keys.json
# Set a build/snapshot identifier when collecting evaluation runs.
AGENT_BUILD_VERSION=local-unversioned

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Public resume demo: enable on the public single-worker deployment.
# Set CORS_ORIGINS to the exact public HTTPS origin. Use false ONLY for local HTTP.
PUBLIC_DEMO_ENABLED=false
PUBLIC_COOKIE_SECURE=true
PUBLIC_REQUESTS_PER_MINUTE=12
PUBLIC_DAILY_CHAT_LIMIT=300
PUBLIC_MAX_CONCURRENT=5
PUBLIC_MAX_OUTPUT_TOKENS=2048
PUBLIC_BUDGET_DB=var/demo/budget.sqlite3
